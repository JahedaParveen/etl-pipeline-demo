# Copy this file to .env and adjust as needed. All values are placeholders.

# --- Postgres (used by docker compose) ---
POSTGRES_USER=etl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=weather
POSTGRES_HOST_PORT=5433
PREFECT_HOST_PORT=4200

# --- Pipeline ---
SCHEDULE_CRON=0 * * * *
RUN_ON_STARTUP=true
PAST_DAYS=1
EXTRACT_RETRIES=3
EXTRACT_RETRY_DELAY_SECONDS=10
HTTP_TIMEOUT_SECONDS=20

# none | once (fail the first attempt, then recover) | always (fail every attempt and alert)
SIMULATE_FAILURE=none

# --- Alerts (optional) ---
# Leave empty to write alerts to the log. Paste a Slack or Teams incoming webhook URL to enable.
ALERT_WEBHOOK_URL=
# slack | teams
ALERT_FORMAT=slack
